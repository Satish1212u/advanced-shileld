{
  "name": "advanced-adblocker",
  "version": "1.0.0",
  "description": "Production-grade, high-performance browser ad-blocking and privacy extension for Chromium Manifest V3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build-extension.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:rules": "tsx scripts/build-rules.ts",
    "update:filters": "tsx scripts/update-filters.ts"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
